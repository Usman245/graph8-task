# Server-only. Never commit. Never prefix these with NEXT_PUBLIC_.
GRAPH8_BASE_URL=https://be.graph8.com/api/v1
GRAPH8_API_KEY=
GRAPH8_WORKFLOW_ID=
GRAPH8_SCOPE_WORKFLOW_ID=
GRAPH8_SKILL_ID=
GRAPH8_MODEL_ID=

PROMISEGUARD_APP_PASSWORD=
PROMISEGUARD_SESSION_SECRET=generate_32+_random_chars
PROMISEGUARD_SELLER_DOMAINS=agency.example
# Format: graph8UserId:Display Name,graph8UserId2:Other Name
PROMISEGUARD_ASSIGNEES=
# Enable Demo mode (sample conversation + [PromiseGuard Demo] Graph8 records). Live mode is always available.
PROMISEGUARD_DEMO_ENABLED=true

# Quote Guard autopilot (optional). Graph8 calls PROMISEGUARD_PUBLIC_URL/api/webhooks/graph8?token=... on
# quote.created / quote.updated / quote.sent. Register it with: node scripts/setup-promiseguard.mts webhook
# Without these, use "Scan now" on the Quote Guard page.
PROMISEGUARD_PUBLIC_URL=
PROMISEGUARD_WEBHOOK_TOKEN=generate_32+_random_chars
PROMISEGUARD_AUTOPILOT_DELAY_SECONDS=15
PROMISEGUARD_MAX_SOURCES=5
PROMISEGUARD_MAX_SOURCE_CHARS=40000
PROMISEGUARD_MAX_QUOTE_CHARS=12000
PROMISEGUARD_MAX_FINDINGS=12
PROMISEGUARD_MAX_REPORT_BYTES=24000
